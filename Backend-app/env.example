# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=crisis_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=crisis_db

# Set to "localhost" when running outside Docker, leave as "db" inside Docker
DB_HOST=db
DB_PORT=5432

# ── pgAdmin ────────────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@crisismap.local
PGADMIN_DEFAULT_PASSWORD=change_me_too

# ── AI model ───────────────────────────────────────────────────────────────────
# baseline  → uses CLIP_CrisisKAN_Baseline (single pooler output)
# option_c  → uses CLIP_CrisisKAN_TCG (task-conditioned gated fusion)
MODEL_VARIANT=option_c
MODEL_WEIGHTS_PATH=app/ai_core/best.pt
